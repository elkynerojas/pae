# =============================================================================
# CONFIGURACIÓN DEL SERVICIO DE HUELLA DIGITAL
# =============================================================================
# Agregar estas variables al archivo .env de tu proyecto Laravel

# URL del servicio SecuGen (por defecto: https://localhost:8443)
SECUGEN_URL=https://localhost:8443

# Licencia del SDK (dejar vacía para modo de prueba)
SECUGEN_LICENCIA=

# Configuración de captura
SECUGEN_TIMEOUT=10000
SECUGEN_CALIDAD=50
SECUGEN_FORMATO=ISO

# Umbral de coincidencia para verificar duplicados (120 es recomendado)
SECUGEN_UMBRAL=120

# Verificar certificados SSL (false para desarrollo local)
SECUGEN_VERIFICAR_SSL=false

# Modo de desarrollo (permite simulación si no hay lector)
HUELLA_MODO_DESARROLLO=true

# =============================================================================
# INSTRUCCIONES DE USO:
# =============================================================================
# 1. Copiar estas variables al archivo .env
# 2. Ejecutar: php artisan config:cache
# 3. Probar: php artisan huella:verificar-servicio
# 4. Usar el formulario de beneficiarios en Filament
# =============================================================================

